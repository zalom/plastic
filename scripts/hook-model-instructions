#!/usr/bin/env ruby
# encoding: UTF-8
# Usage: hook-model-instructions [plugin_root]
# UserPromptSubmit fallback for model-conditional instruction injection (intent
# 185). Reads the model the statusline last cached for this session_id and
# injects once, when the primary session-start path did not fire (for example
# after /clear, where the stdin model field is absent). Fail-open: any error
# means silent exit 0, and nothing prints on the no-injection path (stray
# stdout here becomes injected context on UserPromptSubmit).

require "json"
require_relative "lib/model_instructions"

def emit_model_instructions(plugin_root)
  raw = $stdin.tty? ? "" : ($stdin.read rescue "")
  payload = begin
    JSON.parse(raw)
  rescue StandardError
    {}
  end
  payload = {} unless payload.is_a?(Hash)

  session_id = payload["session_id"].to_s
  return if session_id.empty?

  cache_path = "/tmp/#{ModelInstructions::CACHE_PREFIX}#{session_id}"
  return unless File.exist?(cache_path)

  cached_model = File.read(cache_path).strip
  return if cached_model.empty?

  read_config = if plugin_root && !plugin_root.to_s.empty?
    "#{plugin_root}/scripts/read-config"
  else
    File.expand_path("~/.plastic/scripts/read-config")
  end
  model_instructions_reader = -> { `"#{read_config}" model_instructions.opus`.strip }
  advisor_reader = -> { `"#{read_config}" advisor.enabled`.strip }

  text = ModelInstructions.injection(
    model: cached_model,
    session_id: session_id,
    plugin_root: plugin_root,
    state_dir: "/tmp",
    model_instructions_reader: model_instructions_reader,
    advisor_reader: advisor_reader
  )
  print text if text
end

begin
  emit_model_instructions(ARGV[0])
rescue Exception
  # Fail open: never block the session, never print on the error path.
end
exit 0
