#!/usr/bin/env ruby
# encoding: UTF-8
# Usage: hook-opus-manual [plugin_root]
# UserPromptSubmit fallback for the Opus manual injection (intent 185). Reads
# the model the statusline last cached for this session_id and injects the
# manual once, when the primary session-start path did not fire (for example
# after /clear, where the stdin model field is absent). Fail-open: any error
# means silent exit 0, and nothing prints on the no-injection path (stray
# stdout here becomes injected context on UserPromptSubmit).

require "json"
require_relative "lib/opus_manual"

def emit_opus_manual(plugin_root)
  raw = $stdin.tty? ? "" : ($stdin.read rescue "")
  payload = begin
    JSON.parse(raw)
  rescue StandardError
    {}
  end
  payload = {} unless payload.is_a?(Hash)

  session_id = payload["session_id"].to_s
  return if session_id.empty?

  cache_path = "/tmp/#{OpusManual::CACHE_PREFIX}#{session_id}"
  return unless File.exist?(cache_path)

  cached_model = File.read(cache_path).strip
  return if cached_model.empty?

  read_config = if plugin_root && !plugin_root.to_s.empty?
    "#{plugin_root}/scripts/read-config"
  else
    File.expand_path("~/.plastic/scripts/read-config")
  end
  config_reader = -> { `"#{read_config}" context.opus_manual`.strip }

  text = OpusManual.injection(
    model: cached_model,
    session_id: session_id,
    plugin_root: plugin_root,
    state_dir: "/tmp",
    config_reader: config_reader
  )
  print text if text
end

begin
  emit_opus_manual(ARGV[0])
rescue Exception
  # Fail open: never block the session, never print on the error path.
end
exit 0
