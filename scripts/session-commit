#!/usr/bin/env ruby
# encoding: UTF-8
# frozen_string_literal: true

# session-commit (intent 390) - records one verified checklist item as an
# "Item" savepoint line and prints the instruction for landing it. Plastic
# runs no version control command: it never commits, pushes, or opens a
# pull request itself (spec: "Plastic runs no version control command").
# Fail-open: a store or ledger write failure degrades to a warning, never a
# non-zero exit, except a usage error.
#
# Usage:
#   session-commit --cwd <dir> --summary <text> [--ref REF] [--session <id>]
#                   [--day <YYYYMMDD>] [--store <dir>] [--plastic-home <dir>]
#
# Exit codes:
#   0 - always, except a usage error
#   2 - usage error (missing --cwd or --summary); nothing is written

require_relative "lib/store_layout"
require "fileutils"
require_relative "lib/session_ledger"
require_relative "lib/store_provisioning"
require_relative "lib/pull_request_templates"

def usage_abort(message)
  warn "session-commit: #{message}"
  exit 2
end

def next_value!(argv, i, flag)
  usage_abort("#{flag} requires a value") if i + 1 >= argv.length
  argv[i + 1]
end

def parse_args(argv)
  opts = { cwd: nil, summary: nil, ref: nil, session: nil, day: nil, store: nil, plastic_home: nil }
  i = 0
  while i < argv.length
    arg = argv[i]
    case arg
    when "--cwd"          then opts[:cwd] = next_value!(argv, i, arg); i += 1
    when "--summary"      then opts[:summary] = next_value!(argv, i, arg); i += 1
    when "--ref"          then opts[:ref] = next_value!(argv, i, arg); i += 1
    when "--session"      then opts[:session] = next_value!(argv, i, arg); i += 1
    when "--day"          then opts[:day] = next_value!(argv, i, arg); i += 1
    when "--store"        then opts[:store] = next_value!(argv, i, arg); i += 1
    when "--plastic-home" then opts[:plastic_home] = next_value!(argv, i, arg); i += 1
    else
      usage_abort("unknown flag #{arg.inspect}")
    end
    i += 1
  end
  opts
end

def expand(path)
  File.expand_path(path.to_s.sub(/\A~/, Dir.home))
end

# Sibling of this script's dir, matching append-ledger's own resolution:
# in-repo (<repo>/scripts/session-commit -> <repo>/templates) and installed
# (~/.plastic/scripts/session-commit -> ~/.plastic/templates).
def default_templates_dir
  File.expand_path("../templates", __dir__)
end

# The instruction that lands the item. Inside a registered project: change to
# its path and commit the way its own AGENTS.md says, naming both, then one
# line per pull request or merge request template the repository carries, or
# a pointer at `plastic help completion-and-done` when it carries none.
# Outside a registered project, no repository is named: the record already
# went to the global store, and completion-and-done is the only pointer.
def instruction_for(plastic_home:, project:)
  registered = project != "global" && StoreProvisioning.registered?(project, plastic_home)
  return "plastic help completion-and-done names how to land this" unless registered

  repo = StoreProvisioning.load_projects(plastic_home).dig(project, "path")
  lines = ["cd #{repo} and commit the way #{repo}/AGENTS.md says"]
  template_lines = PullRequestTemplates.instructions(repo)
  if template_lines.empty?
    lines << "plastic help completion-and-done names what comes after the commit"
  else
    lines.concat(template_lines)
  end
  lines.join("\n")
end

def main(argv)
  opts = parse_args(argv)
  usage_abort("--cwd is required") if opts[:cwd].nil?
  usage_abort("--summary is required") if opts[:summary].nil?

  plastic_home = expand(opts[:plastic_home] || ENV.fetch("PLASTIC_HOME", "~/.plastic"))
  store = opts[:store] ? expand(opts[:store]) : Plastic::StoreLayout.global_store(plastic_home)
  cwd = expand(opts[:cwd])

  day = opts[:day] || SessionLedger.day_id
  session = SessionLedger.short_session_id(opts[:session], ENV["CLAUDE_CODE_SESSION_ID"])
  project = SessionLedger.project_slug(cwd, plastic_home: plastic_home)

  begin
    templates = default_templates_dir
    SessionLedger.open_day(store: store, day: day, templates: templates, author: session) if Dir.exist?(templates)
  rescue StandardError => e
    warn "session-commit: could not open the day ledger: #{e.message}"
  end

  summary = opts[:ref].to_s.strip.empty? ? opts[:summary] : "#{opts[:summary]} (ref #{opts[:ref]})"

  begin
    # Does not depend on open_day having run: a damaged install with no
    # templates/, or a store error above, must not also block the append.
    savepoint_path = SessionLedger.savepoint_path(store, day)
    FileUtils.mkdir_p(File.dirname(savepoint_path))
    line = SessionLedger.savepoint_line("Item", session, project, summary, now: Time.now)
    SessionLedger.append_line(savepoint_path, line, header: nil)
  rescue StandardError => e
    warn "session-commit: could not write the savepoint line: #{e.message}"
  end

  puts instruction_for(plastic_home: plastic_home, project: project)
  exit 0
rescue StandardError => e
  warn "session-commit: #{e.message}"
  exit 0
end

main(ARGV) if $PROGRAM_NAME == __FILE__
