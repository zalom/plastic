#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true

require "optparse"

require_relative "lib/installer_release"

options = { bin: File.join(Dir.home, ".local", "bin"), plastic_home: File.join(Dir.home, ".plastic"), user_home: Dir.home }
OptionParser.new do |parser|
  parser.on("--directory PATH") { |value| options[:directory] = value }
  parser.on("--version VERSION") { |value| options[:version] = value }
  parser.on("--switch VERSION") { |value| options[:switch] = value }
  parser.on("--home PATH") { |value| options[:home] = value }
  parser.on("--bin PATH") { |value| options[:bin] = value }
  parser.on("--plastic-home PATH") { |value| options[:plastic_home] = value }
  parser.on("--user-home PATH") { |value| options[:user_home] = value }
end.parse!

required = options[:switch] ? %i[home] : %i[directory version home]
missing = required.reject { |key| options[key] }
abort "missing required options: #{missing.join(", ")}" unless missing.empty?

def managed(options)
  home = InstallerRelease::ManagedHome.new(plastic_home: options[:plastic_home], user_home: options[:user_home],
    launcher: File.join(options[:bin], "plastic"))
  InstallerRelease::HomeSync.new(share: options[:home], home: home)
end

def install(options)
  files = InstallerRelease::ReleaseFiles.new(options[:directory]).verify
  ruby = InstallerRelease::Ruby.chosen(ENV.fetch("PLASTIC_RUBY", ""))
  InstallerRelease::ReleaseInstall.new(home: options[:home], sync: managed(options), ruby: ruby)
    .call(archive: files.archive, manifest: files.manifest, expected: InstallerRelease::Manifest.identity(options[:version]))
end

begin
  if options[:switch]
    InstallerRelease::Activation.new(home: options[:home], sync: managed(options)).switch(options[:switch])
  else
    install(options)
  end
rescue => error
  abort "plastic: v#{options[:switch] || options[:version]}: #{error.message}"
end
