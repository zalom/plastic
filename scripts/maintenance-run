#!/usr/bin/env ruby
# encoding: UTF-8
# frozen_string_literal: true

# maintenance-run - the maintenance dispatch wrapper (intent 197). DETECTS (never acquires) a
# target intent's delivery lock (Lock.fresh?) and defers if fresh; otherwise runs the
# requested tool inside MaintenanceGit.run_scoped so the change and its revisions.md receipt
# land as ONE scoped, merged commit on the store's own main, never via `git add -A`.
#
# Dry-run by DEFAULT (mirrors restore-intent-v1's higher-blast-radius default, since this
# tool commits and merges on the shared store repo); --apply is required to write anything.
#
# Usage:
#   maintenance-run --tool project-links --intent <id> [--store <key>] [--plastic-home PATH] [--apply]
#   maintenance-run --tool rebuild-graph [--plastic-home PATH] [--apply]
#   maintenance-run --tool restore-intent-v1 <id> --at <ref> [--plastic-home PATH] [--apply] [--skip-links]
#   maintenance-run --tool rebuild-savepoint --intent <id> [--store <key>] [--plastic-home PATH] [--apply]
#   maintenance-run --tool register-exclusions [--prune] [--rule <name>] [--store <key>] [--plastic-home PATH] [--apply]
#
# project-links here is ALWAYS single-intent: --intent is required. A store-wide
# project-links sweep is the rare, owner-approved batch exception (D2) and is run directly
# with the plain `project-links` tool, never through this wrapper.
#
# --store <key> (a StoreDiscovery key, e.g. "global" or "project:dealintell") disambiguates
# a bare id that exists in more than one store (real, live examples: ids 26 and 15 both
# collide across stores today) - both project-links --intent and restore-intent-v1's own id
# resolution abort loud naming every candidate when ambiguous and --store is not given;
# never silently pick the first match.
#
# Exit codes: 0 applied or clean no-op; 1 usage error; 2 deferred (a target holds a fresh
# delivery lock); 3 the underlying tool reported failure; 4 precondition failed (the store
# working tree was not clean, or is not a git repo at all).

require "open3"
require "time"

require_relative "lib/store_discovery"
require_relative "lib/lock"
require_relative "lib/maintenance_git"
require_relative "lib/bridge"
require_relative "lib/revisions_writer"
require_relative "doctor" # safe: doctor.rb's CLI is behind $PROGRAM_NAME == __FILE__

DEFAULT_HOME = File.join(Dir.home, ".plastic")

# Resolves `id` to exactly one directory. `store:` (a StoreDiscovery key) short-circuits
# resolution to that one store. Without it, more than one matching store is an ambiguity
# this method itself aborts on (never silently pick the first match - the same class of bug
# ACTION_1 fixes inside project-links itself; this helper guards every OTHER caller of
# resolve_dir_for_id, i.e. rebuild-graph's touched-id lock scan and restore-intent-v1's id
# resolution, both of which route through this one function).
def resolve_dir_for_id(discovery, id, store: nil)
  matches = []
  discovery[:stores].each do |s|
    next if store && s[:key] != store

    Dir.children(s[:store]).reject { |e| e.start_with?(".") }.each do |entry|
      full = File.join(s[:store], entry)
      next unless File.directory?(full)

      matches << [s[:key], full] if entry.split("--", 2).first == id.to_s
    end
  end

  return nil if matches.empty?
  if matches.length > 1
    abort_loud("intent #{id.inspect} is ambiguous across stores " \
               "(#{matches.map(&:first).join(", ")}); pass --store <key> to disambiguate")
  end
  matches.first.last
end

def abort_loud(msg, code = 1)
  warn "maintenance-run: #{msg}"
  exit code
end

def parse_argv(argv)
  opts = { tool: nil, intent: nil, store: nil, plastic_home: DEFAULT_HOME, apply: false,
           at: nil, skip_links: false, id: nil, rule: nil, prune: false }
  i = 0
  while i < argv.length
    case argv[i]
    when "--tool" then opts[:tool] = argv[i += 1]
    when "--intent" then opts[:intent] = argv[i += 1]
    when "--store" then opts[:store] = argv[i += 1]
    when "--plastic-home" then opts[:plastic_home] = argv[i += 1]
    when "--apply" then opts[:apply] = true
    when "--at" then opts[:at] = argv[i += 1]
    when "--skip-links" then opts[:skip_links] = true
    when "--rule" then opts[:rule] = argv[i += 1]
    when "--prune" then opts[:prune] = true
    else
      opts[:id] ||= argv[i] # positional id, restore-intent-v1 only
    end
    i += 1
  end
  opts
end

def check_not_fresh!(dir, id)
  return unless dir && Lock.fresh?(dir)

  abort_loud("deferred: intent #{id} holds a FRESH delivery lock; an active delivery is in " \
             "progress. Maintenance never acquires a lock and never waits on one; re-run " \
             "once the delivery finishes or the lock goes stale.", 2)
end

def stamp
  Time.now.utc.strftime("%Y%m%d%H%M%S")
end

def report_result(result)
  if result[:committed]
    puts "maintenance-run: applied and merged (#{result[:changed].size} path(s)): " \
         "#{result[:changed].join(", ")}"
  else
    puts "maintenance-run: no change (already canonical)."
  end
  exit 0
end

def run_project_links(home, intent, store, apply)
  abort_loud("--tool project-links requires --intent <id> (a store-wide sweep runs " \
             "scripts/project-links directly, never through maintenance-run)") unless intent

  discovery = StoreDiscovery.discover(home)
  dir = resolve_dir_for_id(discovery, intent, store: store) # aborts loud itself on ambiguity
  abort_loud("intent #{intent} not found under #{home}#{store ? " (--store #{store})" : ""}") unless dir
  check_not_fresh!(dir, intent)

  tool_path = File.expand_path("project-links", __dir__)
  base_args = ["--plastic-home", home, "--intent", intent]
  base_args += ["--store", store] if store

  unless apply
    system({"RUBYOPT" => nil}, RbConfig.ruby, tool_path, *base_args, "--dry-run")
    exit($?.exitstatus)
  end

  begin
    result = MaintenanceGit.run_scoped(
      repo_dir: home, branch_name: "maintenance/project-links-#{intent}-#{stamp}",
      commit_message: "chore: maintenance - project-links --intent #{intent}"
    ) do
      ok = system({"RUBYOPT" => nil}, RbConfig.ruby, tool_path, *base_args)
      raise "project-links failed for #{intent}" unless ok
    end
  rescue MaintenanceGit::DirtyWorkingTree, MaintenanceGit::NotAGitRepo => e
    abort_loud(e.message, 4)
  rescue RuntimeError => e
    abort_loud(e.message, 3)
  end
  report_result(result)
end

def run_rebuild_graph(home, apply)
  tool_path = File.expand_path("rebuild-graph", __dir__)
  load tool_path unless defined?(RebuildGraph) # matches test/*_test.rb's own load convention

  discovery = StoreDiscovery.discover(home)
  dry = RebuildGraph.new(plastic_home: home, dry_run: true)
  dry_results = dry.run
  touched_ids = dry_results.values.flat_map { |r| r[:changes].map { |c| c[:intent] } }.uniq

  touched_ids.each { |id| check_not_fresh!(resolve_dir_for_id(discovery, id), id) }

  unless apply
    puts "maintenance-run: DRY RUN, #{touched_ids.size} intent(s) would change: #{touched_ids.join(", ")}"
    exit 0
  end

  begin
    result = MaintenanceGit.run_scoped(
      repo_dir: home, branch_name: "maintenance/rebuild-graph-#{stamp}",
      commit_message: "chore: maintenance - rebuild-graph"
    ) do
      ok = system({"RUBYOPT" => nil}, RbConfig.ruby, tool_path, "--plastic-home", home)
      raise "rebuild-graph failed" unless ok
    end
  rescue MaintenanceGit::DirtyWorkingTree, MaintenanceGit::NotAGitRepo => e
    abort_loud(e.message, 4)
  rescue RuntimeError => e
    abort_loud(e.message, 3)
  end
  report_result(result)
end

def run_restore_intent_v1(home, id, at, store, apply, skip_links)
  abort_loud("restore-intent-v1 requires an intent id and --at <ref>") unless id && at

  discovery = StoreDiscovery.discover(home)
  # NOTE: restore-intent-v1's own CLI (scripts/restore-intent-v1:219-238, find_intent_dir)
  # already aborts loud on a cross-store id collision; this resolve_dir_for_id call is only
  # for the LOCK CHECK here (maintenance-run must know which one directory to check
  # Lock.fresh? against). --store is honored the same way for consistency; if omitted and
  # the id is ambiguous, this call aborts BEFORE restore-intent-v1 itself would have run.
  dir = resolve_dir_for_id(discovery, id, store: store)
  abort_loud("intent #{id} not found under #{home}#{store ? " (--store #{store})" : ""}") unless dir
  check_not_fresh!(dir, id)

  tool_path = File.expand_path("restore-intent-v1", __dir__)
  args = [tool_path, id, "--at", at, "--plastic-home", home]
  args << "--skip-links" if skip_links

  unless apply
    system({"RUBYOPT" => nil}, RbConfig.ruby, *args)
    exit($?.exitstatus)
  end

  begin
    result = MaintenanceGit.run_scoped(
      repo_dir: home, branch_name: "maintenance/restore-intent-v1-#{id}-#{stamp}",
      commit_message: "chore: maintenance - restore-intent-v1 #{id}"
    ) do
      ok = system({"RUBYOPT" => nil}, RbConfig.ruby, *args, "--apply")
      raise "restore-intent-v1 failed for #{id}" unless ok
    end
  rescue MaintenanceGit::DirtyWorkingTree, MaintenanceGit::NotAGitRepo => e
    abort_loud(e.message, 4)
  rescue RuntimeError => e
    abort_loud(e.message, 3)
  end
  report_result(result)
end

def run_rebuild_savepoint(home, intent, store, apply)
  abort_loud("--tool rebuild-savepoint requires --intent <id>") unless intent

  discovery = StoreDiscovery.discover(home)
  dir = resolve_dir_for_id(discovery, intent, store: store)
  abort_loud("intent #{intent} not found under #{home}#{store ? " (--store #{store})" : ""}") unless dir
  check_not_fresh!(dir, intent)

  outcome_path = File.join(dir, "outcome.md")
  unless Bridge.stage_file_present?(outcome_path)
    abort_loud("intent #{intent}'s outcome.md is missing or a placeholder; the 124a recipe " \
               "requires a real disposition to echo, and 219 D6 forbids ever inventing one", 1)
  end

  frontmatter = File.read(outcome_path)[/\A---\n(.*?)\n---/m, 1].to_s
  disposition = frontmatter[/^disposition:\s*(\S+)/, 1]
  abort_loud("intent #{intent}'s outcome.md has no disposition: frontmatter field", 1) unless disposition

  unless apply
    puts "maintenance-run: DRY RUN, would reconstruct savepoint.md for #{intent} " \
         "(Bridge.rebuild_savepoint + Done #{disposition} echo)"
    exit 0
  end

  begin
    result = MaintenanceGit.run_scoped(
      repo_dir: home, branch_name: "maintenance/rebuild-savepoint-#{intent}-#{stamp}",
      commit_message: "chore: maintenance - rebuild-savepoint #{intent}"
    ) do
      Bridge.rebuild_savepoint(dir)
      Bridge.append_terminal_savepoint(dir, disposition)
      RevisionsWriter.append!(
        dir,
        why: "reconstruct missing operational savepoint.md (generic operational-gap predicate)",
        rule: "savepoint-operational-reconstruction",
        prior_location: "#{intent}/savepoint.md",
        change: "savepoint.md rebuilt from disk (Bridge.rebuild_savepoint) plus Done " \
                "#{disposition} echo appended (Bridge.append_terminal_savepoint); disposition " \
                "read from outcome.md's own frontmatter, never invented"
      )
    end
  rescue MaintenanceGit::DirtyWorkingTree, MaintenanceGit::NotAGitRepo => e
    abort_loud(e.message, 4)
  rescue RuntimeError => e
    abort_loud(e.message, 3)
  end
  report_result(result)
end

# Renders one store's canonical doctor-exclusions content (spec D6/D7): a leading comment
# block documenting the format, then one `rule_name id id id` line per rule, ids sorted. Pure.
# `existing_text:` (review F2) is the file's raw content BEFORE this run, or nil when the
# file does not exist yet. A hand-edited exclusion file's comments are the only home for an
# exemption's justification (D8: no revisions.md receipt exists for this tool), so an update
# preserves every comment and blank line from `existing_text` verbatim, in original order,
# ahead of the freshly rendered rule lines - it never re-renders over them. The boilerplate
# header is written only when there is no existing file to preserve anything from.
def render_exclusions_file(rules, existing_text: nil)
  if existing_text
    lines = existing_text.each_line.select { |l| l.strip.empty? || l.strip.start_with?("#") }.map(&:chomp)
  else
    lines = [
      "# doctor-exclusions - knowingly-exempt (intent_id, rule) pairs (intent 274).",
      "# Format: rule_name id id id  (one line per rule, ids space-separated).",
      "# Blank lines and lines starting with # are ignored. Ids only, never any other",
      "# content - doctor reports how many findings this file suppressed and where",
      "# this file lives, so the count always stays honest.",
      "",
    ]
  end
  rules.keys.sort.each do |rule_name|
    lines << "#{rule_name} #{rules[rule_name].sort.join(" ")}"
  end
  "#{lines.join("\n")}\n"
end

# register-exclusions (intent 274, spec D7/D8): the one-time population tool. Computes
# violations through Doctor's OWN done_signal_findings_for_dir rather than a reimplementation
# of that predicate (the drift 222 extracted that function to prevent), unions with any
# existing hand-edited file, skips (never aborts on) any intent dir holding a fresh delivery
# lock, and writes ALL stores in one scoped commit (they already live in the single ~/.plastic
# git repo, so a cross-store write is still one repo and one scoped commit - D7).
#
# Writes NO revisions.md entries (D8): this tool modifies no intent directory, only one
# store-level table per store, so 197's receipt-before-write rule (which covers tools that
# structurally edit an intent's OWN files) does not apply, and writing one would mean editing
# every touched Completed intent directory - forbidden, completed intents are immutable. The
# scoped commit plus the diffable exclusion file itself are the receipt.
#
# `prune:` (intent 280) reverses the direction: instead of adding newly-violating ids, it
# removes rows that `DoctorExclusions.dead_rows` reports as suppressing nothing, through the
# SAME walk, the SAME comment-preserving writer, and the SAME dry-run/--apply gate. `known_ids`
# (post-review fix) is resolved against a direct scan of the store's own directory listing, never
# against which ids the INDEX walk happened to visit - an id can have a real directory without
# being listed in INDEX at all (a de-indexed "ghost"), and walk membership alone misclassified
# that as :no_intent (deleted) even though the directory plainly still exists. `evaluated_ids` is
# the narrower set the walk DOES visit; an id with a real directory the walk never evaluated
# carries no evidence either way, so `dead_rows` leaves it out of its result entirely - never
# called dead by the reporter, so `prune` never sees it as a pruning candidate in the first
# place. Three classes of row are additionally held harmless before anything is written
# (`protected_ids`), belt-and-suspenders on top of that gate: an id whose dir was skipped for a
# fresh delivery lock (D6 - the lock skip runs AFTER the id already lands in `evaluated_ids`, but
# BEFORE it can ever reach `consumed`, since findings are never computed for it), an id whose
# intent has not reached a terminal state yet (D6a - savepoint_operational only fires on a
# terminal intent, so the row has nothing to suppress YET), and an id with a real directory that
# is not in `evaluated_ids` at all (on disk, unindexed). A rule left with zero ids after pruning
# is dropped from the hash entirely (D7): `render_exclusions_file` would otherwise write a bare
# `rule_name` line that `DoctorExclusions.parse` rejects as "lists no intent ids".
def run_register_exclusions(home, rule, store, apply, prune = false)
  rule ||= "savepoint_operational"
  unless RuleCatalog.excludable_check?(rule)
    abort_loud("--rule #{rule.inspect} is not excludable (expected one of: " \
               "#{RuleCatalog::EXCLUDABLE_CHECKS.keys.join(", ")})")
  end

  doctor = Doctor.new(plastic_home: home)
  stores = doctor.done_signal_stores(store ? [store] : nil)
  abort_loud("no store matches --store #{store.inspect}") if store && stores.empty?

  plan = {}
  skip_lines = []

  stores.each do |s|
    existing = DoctorExclusions.load(s[:index])
    if existing[:errors].any?
      abort_loud("#{s[:scope]}: existing doctor-exclusions is malformed, refusing to rewrite " \
                 "it (#{existing[:errors].join("; ")})", 1)
    end
    # scrub: DoctorExclusions.load already scrubs internally (never raises, D5), but this
    # raw read feeds render_exclusions_file's own line scan below, which was NOT going
    # through that scrub - an invalid byte in a hand-written comment raised
    # Encoding::CompatibilityError here on every register-exclusions run, dry-run included,
    # even though `existing` itself (loaded via DoctorExclusions.load) reported the file
    # clean. Scrub this read the same way so both paths agree.
    existing_text = File.exist?(existing[:path]) ? File.read(existing[:path]).scrub : nil

    found_ids = []
    consumed = { "savepoint_operational" => [] }
    protected_ids = []

    # `known_ids` (post-review fix): every id with a REAL DIRECTORY in this store, scanned
    # directly from disk - not from the INDEX walk below. Mirrors doctor.rb's own fix: an id can
    # have a directory on disk without being listed in INDEX (a de-indexed "ghost"), and the walk
    # alone would never visit it, misclassifying that ghost as :no_intent (deleted) even though
    # it plainly still exists.
    known_ids = if File.directory?(s[:store_dir])
                  Dir.children(s[:store_dir]).reject { |e| e.start_with?(".") }
                     .select { |e| File.directory?(File.join(s[:store_dir], e)) }
                     .map { |e| e.split("--", 2).first }
                else
                  []
                end
    # `evaluated_ids`: the narrower set the walk below actually judges (INDEX-listed and on disk).
    evaluated_ids = []

    doctor.index_sections_by_dir(s[:index]).each do |dirname, in_sections|
      dir = File.join(s[:store_dir], dirname)
      next unless File.directory?(dir)

      walked_id = dirname.split("--", 2).first
      evaluated_ids << walked_id
      # D6a: savepoint_operational only fires on a terminal intent, so a row naming a live
      # non-terminal intent has nothing to suppress YET. Doctor reports it; prune leaves it.
      protected_ids << walked_id unless (in_sections & ["Completed", "Abandoned"]).any?

      terminal = (in_sections & ["Completed", "Abandoned"]).any?
      next unless terminal

      if Lock.fresh?(dir)
        skip_lines << "#{s[:scope]}: #{dirname} skipped (fresh delivery lock)"
        # Prune direction (intent 280 D6, post-review fix): the lock skip runs AFTER
        # evaluated_ids already recorded this id (just above) but BEFORE findings are computed,
        # so it never reaches `consumed` - dead_rows would read it as :no_finding (evaluated,
        # nothing consumed) purely because we never checked. Hold it harmless via protected_ids
        # regardless of what dead_rows would report.
        protected_ids << walked_id
        next
      end

      active = in_sections.include?("Active") && !terminal
      findings = doctor.done_signal_findings_for_dir(
        dir, label: "#{s[:scope]} store/#{dirname}", scope: s[:scope], dirname: dirname,
        terminal: terminal, active: active, excluded_rules: []
      )
      found_ids << walked_id if findings[:operational_gap].any?
      # `excluded_rules: []` is passed here, so nothing ever fires via this drain; consumed[rule]
      # is instead built from found_ids below for the prune direction. Kept anyway so both
      # directions stay one shape if `excluded_rules:` is ever threaded through this call.
      findings[:excluded_rules_fired].each { |fired| (consumed[fired] ||= []) << walked_id }
    end

    # Post-review fix: an id with a real directory that INDEX never lists at all is walked by
    # neither branch above, so its terminal state is unknowable here. Hold it harmless the same
    # way D6a holds a not-yet-terminal id harmless - protected, never pruned, named as kept (this
    # is defense-in-depth: dead_rows's own evaluated_ids gate already excludes such an id from
    # `dead` in the first place, so this list should never actually need to intervene, but the
    # protection stays explicit rather than relying solely on that gate).
    protected_ids.concat(known_ids - evaluated_ids)

    already = existing[:rules][rule] || []

    if prune
      # This tool calls done_signal_findings_for_dir with excluded_rules: [], so a registered id
      # that still has a gap shows up in found_ids rather than in the :excluded bucket. found_ids
      # IS the consumed set for this rule.
      dead = DoctorExclusions.dead_rows(existing, consumed: { rule => found_ids }, known_ids: known_ids,
                                          evaluated_ids: evaluated_ids)
                             .select { |row| row[:rule] == rule }
                             .map { |row| row[:id] }
      held = dead & protected_ids # D6 (fresh lock) + D6a (not terminal) + on-disk-but-unindexed
      held.each { |id| skip_lines << "#{s[:scope]}: #{id} kept (protected, still live)" }
      dead -= held
      next if dead.empty?

      remaining = already - dead
      merged_rules = existing[:rules].merge(rule => remaining.sort)
      merged_rules.delete(rule) if remaining.empty? # D7: a bare rule line fails to reload
      plan[s] = { content: render_exclusions_file(merged_rules, existing_text: existing_text),
                  removed: dead.sort }
    else
      added = found_ids - already
      next if added.empty?

      merged_rules = existing[:rules].merge(rule => (already | found_ids).sort)
      plan[s] = { content: render_exclusions_file(merged_rules, existing_text: existing_text),
                  added: added.sort }
    end
  end

  puts skip_lines.join("\n") unless skip_lines.empty?

  if plan.empty?
    puts(prune ? "maintenance-run: no dead #{rule} exclusion rows to prune."
               : "maintenance-run: no new #{rule} violations to register.")
    exit 0
  end

  unless apply
    plan.each do |s, info|
      puts(if prune
             "maintenance-run: DRY RUN, #{s[:scope]} would prune #{info[:removed].size} " \
             "dead row(s) under #{rule}: #{info[:removed].join(", ")}"
           else
             "maintenance-run: DRY RUN, #{s[:scope]} would register #{info[:added].size} " \
             "id(s) under #{rule}: #{info[:added].join(", ")}"
           end)
    end
    exit 0
  end

  begin
    result = MaintenanceGit.run_scoped(
      repo_dir: home, branch_name: "maintenance/#{prune ? "prune" : "register"}-exclusions-#{stamp}",
      commit_message: "chore: maintenance - #{prune ? "prune dead" : "register"} doctor exclusions (#{rule})"
    ) do
      plan.each { |s, info| File.write(DoctorExclusions.path_for(s[:index]), info[:content]) }
    end
  rescue MaintenanceGit::DirtyWorkingTree, MaintenanceGit::NotAGitRepo => e
    abort_loud(e.message, 4)
  rescue RuntimeError => e
    abort_loud(e.message, 3)
  end
  report_result(result)
end

def main(argv)
  opts = parse_argv(argv)
  unless opts[:tool]
    abort_loud("--tool is required " \
               "(project-links|rebuild-graph|restore-intent-v1|rebuild-savepoint|register-exclusions)")
  end

  case opts[:tool]
  when "project-links"
    run_project_links(opts[:plastic_home], opts[:intent], opts[:store], opts[:apply])
  when "rebuild-graph" then run_rebuild_graph(opts[:plastic_home], opts[:apply])
  when "restore-intent-v1"
    run_restore_intent_v1(opts[:plastic_home], opts[:id], opts[:at], opts[:store], opts[:apply], opts[:skip_links])
  when "rebuild-savepoint"
    run_rebuild_savepoint(opts[:plastic_home], opts[:intent], opts[:store], opts[:apply])
  when "register-exclusions"
    run_register_exclusions(opts[:plastic_home], opts[:rule], opts[:store], opts[:apply], opts[:prune])
  else
    abort_loud("unknown --tool #{opts[:tool].inspect} (expected project-links|rebuild-graph|" \
               "restore-intent-v1|rebuild-savepoint|register-exclusions)")
  end
end

main(ARGV) if $PROGRAM_NAME == __FILE__
