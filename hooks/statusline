#!/bin/bash
# plastic-hook-version: 4.0.0
# StatusLine hook - Plastic owns the full statusline (no chaining).
# Renders: {model} - ctx {pct}% ({used}k/{size}k) - 5h {p}% - 7d {p}% - ${cost}
#          - claudish {n} rw / {tok} - Plastic {version}[ -> {next}] - {path}
# Every segment but claudish and the Plastic version comes from the stdin payload.
# Pure bash (macOS 3.2 compatible). No ruby, no jq. Reads stdin once; small file reads only.

INPUT=$(cat)

# --- Colors (ANSI-C quoting; bash 3.2 supports $'\033') ---
C_MODEL=$'\033[38;2;90;140;220m'    # navy blue - model
C_CTX=$'\033[38;2;45;212;191m'      # teal      - context window
C_OK=''                             # default   - meter below 70%
C_WARN=$'\033[33m'                  # yellow    - meter at 70% and above
C_CRIT=$'\033[38;2;231;76;60m'      # red       - meter at 90% and above
C_COST=$'\033[37m'                  # white     - session cost
C_CLAUDISH=$'\033[38;2;249;140;30m' # orange    - claudish rewrites
C_VER=$'\033[37m'                   # white     - "Plastic {version}" and update arrow
C_NEXT=$'\033[33m'                  # yellow    - next version
C_PATH=$'\033[38;2;128;134;144m'    # gray      - path (matches dim UI text)
C_SEP=$'\033[38;2;128;134;144m'     # gray      - separators
RST=$'\033[0m'
SEP="${C_SEP} "$'\302\267'" ${RST}"   # " . " middot, dim

# --- Extract a flat JSON string field from stdin: json_str <key> ---
json_str() {
  printf '%s' "$INPUT" \
    | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
    | head -1 \
    | sed "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"//;s/\"$//"
}

# --- Extract the brace-balanced text of a named JSON object: json_obj <json> <key> ---
# Joins the input into one buffer, so pretty-printed and single-line payloads parse
# identically, then walks characters from the opening brace with a depth counter,
# honoring string state so a brace inside a string cannot close the object early.
# A sed line range cannot do this: context_window holds a nested current_usage
# object whose closing brace would end the range too soon. The regex stops at the
# colon and the brace is checked as a plain character, because a brace inside a
# dynamic regex is not portable to the awk that ships with macOS. A null value
# (current_usage is often null) fails that check and yields nothing, which is what
# every caller wants.
json_obj() {
  printf '%s' "$1" | awk -v key="$2" '
    { buf = buf $0 " " }
    END {
      pat = "\"" key "\"[ \t]*:[ \t]*"
      if (match(buf, pat) == 0) exit
      start = RSTART + RLENGTH
      if (substr(buf, start, 1) != "{") exit
      depth = 0; instr = 0; esc = 0
      n = length(buf)
      for (i = start; i <= n; i++) {
        c = substr(buf, i, 1)
        if (instr) {
          if (esc) { esc = 0 }
          else if (c == "\\") { esc = 1 }
          else if (c == "\"") { instr = 0 }
          continue
        }
        if (c == "\"") { instr = 1; continue }
        if (c == "{") { depth++ }
        else if (c == "}") {
          depth--
          if (depth == 0) { print substr(buf, start, i - start + 1); exit }
        }
      }
    }'
}

# --- Read a numeric field out of a JSON fragment: json_num <fragment> <key> ---
# Empty output means absent or null, which every caller reads as "no segment".
json_num() {
  printf '%s' "$1" \
    | grep -o "\"$2\"[[:space:]]*:[[:space:]]*-\{0,1\}[0-9][0-9.]*" \
    | head -1 \
    | sed "s/.*:[[:space:]]*//"
}

# --- Truncate a JSON number to an integer ("42.5" -> "42"); empty stays empty ---
to_int() {
  case "$1" in
    ''|*[!0-9.]*) return ;;
  esac
  _i=${1%%.*}
  [ -z "$_i" ] && _i=0
  printf '%s' "$_i"
}

# --- Model (model.display_name) ---
MODEL=$(json_str "display_name")

# --- Path (workspace.current_dir, fallback top-level cwd) ---
REAL_CWD=$(json_str "current_dir")
[ -z "$REAL_CWD" ] && REAL_CWD=$(json_str "cwd")
# Abbreviate $HOME -> ~
CWD="$REAL_CWD"
case "$CWD" in
  "$HOME") CWD="~" ;;
  "$HOME"/*) CWD="~${CWD#"$HOME"}" ;;
esac

# --- Plastic version ---
VERSION=""
[ -f "$HOME/.plastic/VERSION" ] && VERSION=$(tr -d ' \t\n' < "$HOME/.plastic/VERSION")

# --- Update (next version when one is available) ---
NEXT=""
CACHE_FILE="$HOME/.plastic/.cache/update-check.json"
if [ -f "$CACHE_FILE" ]; then
  if grep -q '"updateAvailable"[[:space:]]*:[[:space:]]*true' "$CACHE_FILE" 2>/dev/null; then
    LATEST=$(grep -o '"latest"[[:space:]]*:[[:space:]]*"[^"]*"' "$CACHE_FILE" 2>/dev/null \
      | head -1 | sed 's/.*"latest"[[:space:]]*:[[:space:]]*"//;s/"$//')
    if [ -n "$LATEST" ]; then
      case "$LATEST" in
        *-*) NEXT="${LATEST##*-}" ;;   # 1.0.0-beta.3 -> beta.3
        *)   NEXT="$LATEST" ;;
      esac
    fi
  fi
fi

# --- Context window (stdin context_window) ---
# used_percentage is the documented input-side figure (input + cache creation +
# cache read), so it wins for the percentage. The token count in parentheses comes
# from current_usage when it is present. Each derives the other when only one is
# available; when both are null there is no ctx segment.
CTX_SEG=""
CW=$(json_obj "$INPUT" "context_window")
if [ -n "$CW" ]; then
  CW_SIZE=$(to_int "$(json_num "$CW" "context_window_size")")
  CW_PCT=$(to_int "$(json_num "$CW" "used_percentage")")
  CW_USED=""
  CU=$(json_obj "$CW" "current_usage")
  if [ -n "$CU" ]; then
    U_IN=$(to_int "$(json_num "$CU" "input_tokens")")
    U_CC=$(to_int "$(json_num "$CU" "cache_creation_input_tokens")")
    U_CR=$(to_int "$(json_num "$CU" "cache_read_input_tokens")")
    if [ -n "$U_IN$U_CC$U_CR" ]; then
      CW_USED=$(( ${U_IN:-0} + ${U_CC:-0} + ${U_CR:-0} ))
    fi
  fi
  if [ -z "$CW_USED" ] && [ -n "$CW_PCT" ] && [ -n "$CW_SIZE" ] && [ "$CW_SIZE" -gt 0 ]; then
    CW_USED=$(( CW_SIZE * CW_PCT / 100 ))
  fi
  if [ -z "$CW_PCT" ] && [ -n "$CW_USED" ] && [ -n "$CW_SIZE" ] && [ "$CW_SIZE" -gt 0 ]; then
    CW_PCT=$(( CW_USED * 100 / CW_SIZE ))
  fi
  if [ -n "$CW_PCT" ]; then
    CTX_SEG="${C_CTX}ctx ${CW_PCT}%"
    if [ -n "$CW_USED" ] && [ -n "$CW_SIZE" ] && [ "$CW_SIZE" -gt 0 ]; then
      CTX_SEG="${CTX_SEG} ($(( (CW_USED + 500) / 1000 ))k/$(( CW_SIZE / 1000 ))k)"
    fi
    CTX_SEG="${CTX_SEG}${RST}"
  fi
fi

# --- Subscription meters (stdin rate_limits; absent for API-key sessions) ---
meter_seg() {   # $1 = label, $2 = object key
  _obj=$(json_obj "$INPUT" "$2")
  [ -z "$_obj" ] && return
  _p=$(to_int "$(json_num "$_obj" "used_percentage")")
  [ -z "$_p" ] && return
  _c="$C_OK"
  [ "$_p" -ge 70 ] && _c="$C_WARN"
  [ "$_p" -ge 90 ] && _c="$C_CRIT"
  printf '%s' "${_c}$1 ${_p}%${RST}"
}
M5=$(meter_seg "5h" "five_hour")
M7=$(meter_seg "7d" "seven_day")

# --- Session cost (stdin cost.total_cost_usd); hidden when it renders as $0.00 ---
COST_SEG=""
CO=$(json_obj "$INPUT" "cost")
if [ -n "$CO" ]; then
  COST_RAW=$(json_num "$CO" "total_cost_usd")
  if [ -n "$COST_RAW" ]; then
    COST_FMT=$(awk -v c="$COST_RAW" 'BEGIN { if (c + 0 >= 0.005) printf "%.2f", c }')
    [ -n "$COST_FMT" ] && COST_SEG="${C_COST}\$${COST_FMT}${RST}"
  fi
fi

# --- claudish rewrites for THIS session (fork ledger, optional) ---
# Tab separated, one call per line; column 11 is the session id. Rows written
# before that column existed have 9 or 10 fields and never match, so an old
# ledger renders no segment instead of a wrong one.
CL_SEG=""
SID=$(json_str "session_id")
CL_LOG="${CLAUDISH_LOCAL_DIR:-$HOME/.claude/claudish-local}/usage.log"
if [ -n "$SID" ] && [ -f "$CL_LOG" ]; then
  CL=$(awk -F'\t' -v sid="$SID" '
    NF >= 11 && $11 == sid { n++; t += $5 + $6 }
    END {
      if (n > 0) {
        if (t >= 1000) {
          s = sprintf("%.1f", t / 1000); sub(/\.0$/, "", s); printf "%d %sk", n, s
        } else {
          printf "%d %d", n, t
        }
      }
    }' "$CL_LOG" 2>/dev/null)
  [ -n "$CL" ] && CL_SEG="${C_CLAUDISH}claudish ${CL%% *} rw / ${CL#* }${RST}"
fi

# --- Assemble segments in order, joined by " . " ---
PARTS=""
add() { [ -z "$1" ] && return; if [ -z "$PARTS" ]; then PARTS="$1"; else PARTS="$PARTS$SEP$1"; fi; }

# Order: identity first (model), then this session's spend (context, meters, cost,
# rewrites), then the volatile-length values last (version, path) so the line does
# not visually jump as they change.
[ -n "$MODEL" ] && add "${C_MODEL}${MODEL}${RST}"
add "$CTX_SEG"
add "$M5"
add "$M7"
add "$COST_SEG"
add "$CL_SEG"
if [ -n "$VERSION" ]; then
  vseg="${C_VER}Plastic ${VERSION}${RST}"
  [ -n "$NEXT" ] && vseg="${vseg}${C_VER} "$'\342\206\222'" ${RST}${C_NEXT}${NEXT}${RST}"
  add "$vseg"
fi
[ -n "$CWD" ] && add "${C_PATH}${CWD}${RST}"

printf '%s\n' "$PARTS"
