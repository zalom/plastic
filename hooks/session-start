#!/bin/bash
# Plastic session-start hook — reads global intent store at ~/.plastic/
# Falls back to per-project .plastic/ for legacy/local installs

GLOBAL_INDEX="$HOME/.plastic/INDEX.md"
LOCAL_INDEX=".plastic/INDEX.md"
GLOBAL_PROJECTS="$HOME/.plastic/projects.yml"

# Determine which index to use
if [ -f "$GLOBAL_INDEX" ]; then
  INDEX="$GLOBAL_INDEX"
  STORE_ROOT="$HOME/.plastic"
  MODE="global"
elif [ -f "$LOCAL_INDEX" ]; then
  INDEX="$LOCAL_INDEX"
  STORE_ROOT=".plastic"
  MODE="local"
else
  exit 0
fi

# Read intent data + detect current project
INTENT_DATA=$(ruby -r json -r date -r yaml <<RUBY 2>/dev/null
  index_path = "${INDEX}"
  store_root = "${STORE_ROOT}"
  mode = "${MODE}"
  cwd = Dir.pwd

  lines = File.readlines(index_path)
  active = []
  future = []
  section = nil

  lines.each do |line|
    if line.start_with?("## Active")
      section = :active
      next
    elsif line.start_with?("## Future")
      section = :future
      next
    elsif line.start_with?("## ")
      section = nil
      next
    end

    next unless section && line.strip.start_with?("- [")

    if section == :active
      active << line.strip
    elsif section == :future
      future << line.strip
    end
  end

  # Check for stale future intents
  stale = []
  stale_days = 3
  config_path = "#{store_root}/config.yml"
  if File.exist?(config_path)
    config = YAML.safe_load(File.read(config_path)) rescue {}
    stale_days = config["stale_threshold_days"] || 3
  end

  future.each do |f|
    if f =~ /store\/([\w-]+)\//
      dir = "#{store_root}/store/#{$1}"
      intent_file = "#{dir}/intent.md"
      next unless File.exist?(intent_file)

      content = File.read(intent_file)
      if content =~ /^updated:\s*(\d{4}-\d{2}-\d{2})/
        updated = Date.parse($1)
        age = (Date.today - updated).to_i
        if age >= stale_days
          name = f[/\[([^\]]+)\]/, 1] || "unknown"
          stale << { entry: f, age: age, name: name }
        end
      end
    end
  end

  # Detect current project from projects.yml
  current_project = nil
  if mode == "global"
    projects_path = "#{store_root}/projects.yml"
    if File.exist?(projects_path)
      projects = YAML.safe_load(File.read(projects_path)) rescue {}
      (projects["projects"] || {}).each do |slug, info|
        project_path = File.expand_path(info["path"])
        if cwd.start_with?(project_path)
          current_project = { slug: slug, parent: info["parent"], path: project_path }
          break
        end
      end
    end
  end

  result = {
    active: active,
    future: future,
    stale: stale,
    mode: mode,
    current_project: current_project
  }
  puts JSON.generate(result)
RUBY
)

if [ -z "$INTENT_DATA" ]; then
  exit 0
fi

HAS_ACTIVE=$(echo "$INTENT_DATA" | ruby -r json -e 'puts JSON.parse(STDIN.read)["active"].any?' 2>/dev/null)
HAS_STALE=$(echo "$INTENT_DATA" | ruby -r json -e 'puts JSON.parse(STDIN.read)["stale"].any?' 2>/dev/null)

if [ "$HAS_ACTIVE" != "true" ] && [ "$HAS_STALE" != "true" ]; then
  FUTURE_COUNT=$(echo "$INTENT_DATA" | ruby -r json -e 'puts JSON.parse(STDIN.read)["future"].length' 2>/dev/null)
  if [ "$FUTURE_COUNT" = "0" ]; then
    exit 0
  fi
fi

CONTEXT=$(ruby -r json <<RUBY 2>/dev/null
  data = JSON.parse('${INTENT_DATA}')
  parts = []
  mode = data["mode"]
  project = data["current_project"]

  if mode == "global"
    if project
      parts << "PLASTIC — Global store | Project: #{project["slug"]} (#{project["path"]})\\n"
      if project["parent"]
        parts << "Governing intent: #{project["parent"]}\\n"
      end
    else
      parts << "PLASTIC — Global store loaded from ~/.plastic/\\n"
    end
  else
    parts << "PLASTIC — Local store loaded from .plastic/\\n"
  end

  if data["active"].any?
    parts << "Active intents:\\n"
    data["active"].each { |a| parts << a }
    parts << ""
  else
    parts << "No active intents. #{data["future"].length} future intents available.\\n"
  end

  if data["stale"].any?
    parts << "\\nStale future intents (untouched for days):\\n"
    data["stale"].each do |s|
      parts << "- #{s["name"]} (#{s["age"]} days) — consider: activate, abandon, or defer to agent"
    end
    parts << "\\nWhen appropriate, ask the user what to do with stale intents."
  end

  puts parts.join("\\n")
RUBY
)

cat <<HOOKJSON
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${CONTEXT}"
  }
}
HOOKJSON
