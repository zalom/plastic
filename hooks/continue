#!/bin/bash
INPUT=$(cat)
MESSAGE=$(echo "$INPUT" | ruby -rjson -e 'puts JSON.parse(STDIN.read)["user_prompt"]' 2>/dev/null || echo "")

if echo "$MESSAGE" | grep -iq '\bcontinue\b'; then
  GLOBAL_INDEX="$HOME/.plastic/INDEX.md"

  if [ ! -f "$GLOBAL_INDEX" ]; then
    exit 0
  fi

  INDEX="$GLOBAL_INDEX"
  STORE_ROOT="$HOME/.plastic"
  MODE="global"

  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  OUTPUT=$(ruby "$SCRIPT_DIR/../scripts/hook-continue" "$INDEX" "$STORE_ROOT" "$MODE" 2>/dev/null)

  if [ -n "$OUTPUT" ]; then
    echo "$OUTPUT"
  else
    cat <<'HOOKJSON'
{
  "hookSpecificOutput": {
    "hookEventName": "UserPromptSubmit",
    "additionalContext": "PLASTIC CONTINUE: The user wants to resume previous work.\n\nRead ~/.plastic/INDEX.md and follow the plastic-continuing skill workflow."
  }
}
HOOKJSON
  fi
fi
